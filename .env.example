# Copy to .env and supply your restricted local MySQL runtime credentials. Never use production data.
DATABASE_URL="mysql://LOCAL_APPLICATION_USER:LOCAL_PASSWORD@127.0.0.1:3308/voltronix_billing_dev"
# Empty selects pinned local development transport or verified TLS elsewhere.
# Production uses verify-full; never disable certificate validation.
DATABASE_TLS_MODE=""
DATABASE_TLS_CA_FILE=""
# Actual origin used to access this app. OAuth callbacks and mutation checks derive from it.
# Keep loopback for local work; an approved hosted instance needs its own exact HTTPS origin.
APP_URL="http://127.0.0.1:3000"
UPLOAD_DIR=".local/mysql-uploads"
# Fictional seeds require both flags, a loopback voltronix_billing_dev database, and explicit passwords.
APP_ENV="development"
# Set true for manual bills with local jobs/vendors and no external integrations.
MANUAL_ENTRY_ONLY="false"
ALLOW_DEMO_SEED="false"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Optional development Accounts user, for payment recording and accounting operations.
SEED_ACCOUNTS_EMAIL=""
SEED_ACCOUNTS_PASSWORD=""
# Mandatory invoice OCR uses server-side Azure Document Intelligence prebuilt-invoice.
# After configuring your Azure resource, set OCR_PROVIDER="azure_document_intelligence".
# Credentials stay server-side; never prefix them with NEXT_PUBLIC_ or paste them in chat.
# Configure the resource/region and permitted invoice processing before enabling uploads.
# Live acceptance: npm run test:ocr:live -- --allow-live (two synthetic invoices; Azure usage).
OCR_PROVIDER="disabled"
# Example resource shape: https://YOUR-RESOURCE.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=""
AZURE_DOCUMENT_INTELLIGENCE_KEY=""

# Scoped scanner intake. Enable only after source/company assignment and share access are reviewed.
SCANNER_IMPORT_ENABLED="false"
# Trusted local operator provisioning; do not copy these into the folder worker configuration.
ALLOW_SCANNER_ADMINISTRATION="false"
SCANNER_COMPANY_ID=""
SCANNER_SOURCE_NAME=""
# create writes a protected worker config; enable/disable/rotate select its exact source ID.
SCANNER_SOURCE_ID=""

# Trusted operator account administration. Supply values only for the intended command,
# then clear them. Never put real secrets in this example or command-line arguments.
ALLOW_ACCOUNT_ADMINISTRATION="false"
ACCOUNT_OPERATOR_EMAIL=""
ACCOUNT_OPERATOR_PASSWORD=""
ACCOUNT_OPERATION=""
ACCOUNT_EMAIL=""
ACCOUNT_REASON=""
ACCOUNT_NEW_PASSWORD=""

# Operator-only setup. Keep disabled except during the intended invocation.
# See docs/BOOKS_OPERATIONAL_SETUP.md. Never place operator passwords in command arguments.
ALLOW_OPERATIONAL_COMPANY_SETUP="false"
COMPANY_SETUP_NAME=""
COMPANY_SETUP_ORGANIZATION_ID=""
COMPANY_SETUP_REFERENCE=""
COMPANY_SETUP_MEMBER_EMAIL=""
ALLOW_BOOKS_AUTHORIZATION="false"
BOOKS_AUTHORIZATION_ORGANIZATION_ID=""
ALLOW_BOOKS_CATALOG_READ="false"
ALLOW_BOOKS_OPERATIONAL_VERIFICATION="false"
ALLOW_BOOKS_SUPPLIER_SETUP="false"
BOOKS_SUPPLIER_IDS_JSON=""
BOOKS_SUPPLIER_SETUP_REFERENCE=""
BOOKS_COMPANY_ID=""
BOOKS_ORGANIZATION_ID=""
BOOKS_ORGANIZATION_NAME=""
BOOKS_VERIFICATION_REFERENCE=""

# Restore verification is read-only and accepts a separate loopback bills_restore_* DB.
ALLOW_RESTORE_VERIFICATION="false"
RESTORE_DATABASE_URL=""
RESTORE_UPLOAD_DIR=""
RESTORE_EXPECTED_BILLS=""
RESTORE_EXPECTED_DOCUMENTS=""

# Zoho: disabled until actual organization, DC, scopes and mappings are verified.
# A sandbox label alone is NOT proof of isolation. Sandbox writes require a matching,
# expiring operator attestation. Live writes have additional runtime/company/per-bill gates.
INTEGRATION_NETWORK_ENABLED="false"
# Per-provider kill switches; an explicit false also blocks that provider's network access.
ZOHO_BOOKS_NETWORK_ENABLED="false"
ZOHO_CRM_NETWORK_ENABLED="false"
# Live mode remains unusable in this demo environment even if the flag is changed.
ZOHO_BOOKS_LIVE_ENABLED="false"
# Trusted local OAuth setup creates separate connection-check entries, never live companies.
ALLOW_BOOKS_LOCAL_CONNECTION_SETUP="false"
# Legacy production flag remains a deny switch: true blocks writes.
ALLOW_PRODUCTION_ACCOUNTING_WRITES="false"
INTEGRATION_TEST_MODE="false"
# Legacy single-organization attestation only; profiles use their own testAuthorization.
ZOHO_BOOKS_TEST_AUTHORIZATION_JSON=""
INTEGRATION_TOKEN_ENCRYPTION_KEY=""
ZOHO_BOOKS_WRITE_ENABLED="false"
#Zoho Books
ZOHO_BOOKS_DC=""
ZOHO_BOOKS_ORGANIZATION_ID=""
# Multiple destinations: array of {organizationId,name,mapping?,testAuthorization?}.
# Leave the singular ORGANIZATION_ID empty when using this list. Explicit selection required.
# Mapping/authorization belong to each profile; global mapping must not be reused across companies.
ZOHO_BOOKS_ORGANIZATIONS_JSON=""
ZOHO_BOOKS_ENVIRONMENT=""
ZOHO_BOOKS_CLIENT_ID=""
ZOHO_BOOKS_CLIENT_SECRET=""
# Backend-only bootstrap: legacy scalar applies only to one configured organization.
# Leave empty when using the scoped map; a shared token never bootstraps multiple profiles.
ZOHO_BOOKS_REFRESH_TOKEN=""
# Server-only JSON object: exact configured organization ID -> refresh token.
# Example shape only: {"100":"fictional-token-a","200":"fictional-token-b"}
# Use either this map or the scalar, never both. Omitted organizations need their own stored grant.
# Tokens: 1-4096 characters without whitespace/control characters; maximum 20 entries.
# Duplicate/unknown IDs or malformed input block configuration. Never use NEXT_PUBLIC_ for secrets.
# Successful bootstrap stores encrypted tokens; existing vault grants and revocation take precedence.
ZOHO_BOOKS_REFRESH_TOKENS_JSON=""
# Legacy single-organization mapping only; profiles use their own mapping.
ZOHO_BOOKS_MAPPING_JSON=""

# Zoho CRM: separate product organization and grant; never use a Books organization ID/token.
# Add /api/integrations/oauth/crm/callback for the exact app origin to the OAuth client.
# A verified same-DC app registration may supply both products' client settings; consent is separate.
ZOHO_CRM_DC=""
ZOHO_CRM_ORGANIZATION_ID=""
ZOHO_CRM_ENVIRONMENT=""
ZOHO_CRM_CLIENT_ID=""
ZOHO_CRM_CLIENT_SECRET=""
# Leave empty with browser OAuth; the CRM callback saves this product's refresh token encrypted in MySQL.
ZOHO_CRM_REFRESH_TOKEN=""
ZOHO_CRM_MAPPING_JSON=""

# Independent Hub read bridge; disabled until explicit user/company bindings exist.
HUB_BRIDGE_ENABLED=false
HUB_BRIDGE_ISSUER=https://hub.voltronix.ae
HUB_BRIDGE_SECRET=

# Recurring GET-only Zoho source sync; supervised separately from outgoing billing.
INCOMING_SYNC_ENABLED=false
INCOMING_SYNC_INTERVAL_SECONDS=60
INCOMING_SYNC_RECONCILE_SECONDS=86400
INCOMING_SYNC_MAX_REQUESTS=40
INCOMING_SYNC_ATTACHMENTS_ENABLED=true
INCOMING_SYNC_OPERATOR_EMAIL=
INCOMING_SYNC_OPERATOR_PASSWORD=
# Optional private JSON from the previous original downloader, used only for known quota delays.
INCOMING_SYNC_ATTACHMENT_STATE_FILE=
# Optional explicit source cooldowns: {"ZOHO:organization_id":"ISO-8601 timestamp"}
INCOMING_SYNC_NOT_BEFORE_JSON=
