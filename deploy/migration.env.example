# Separate dedicated migrator, same operational schema. Never mount into web/sync.
APP_ENV=production
NODE_ENV=production
APP_URL=https://bills.voltronix.ae
DATABASE_URL=mysql://billing_migrator:REPLACE_PRIVATELY@MYSQL_HOST:3306/billing_operational
DATABASE_TLS_MODE=verify-full
DATABASE_TLS_CA_FILE=
UPLOAD_DIR=/var/lib/voltronix/uploads
INTEGRATION_TEST_MODE=false
ALLOW_PRODUCTION_MIGRATION=false
