# Copy to deploy/.env.production on the production host only.
# Keep this file private and readable by container UID 1000. Never reuse local .env.
APP_ENV=production
NODE_ENV=production
APP_URL=https://bills.voltronix.ae
# Typed bill entry uses Save and sync. true is the optional local-ledger-only mode.
MANUAL_ENTRY_ONLY=false
DATABASE_URL=mysql://billing_runtime:REPLACE_PRIVATELY@MYSQL_HOST:3306/billing_operational
DATABASE_TLS_MODE=verify-full
# Leave empty for a public CA, or use the CA override compose file and this path.
DATABASE_TLS_CA_FILE=
UPLOAD_DIR=/var/lib/voltronix/uploads
ALLOW_DEMO_SEED=false
INTEGRATION_TEST_MODE=false
# Allow Books authorization and read-only setup; financial writes stay off below.
INTEGRATION_NETWORK_ENABLED=true
ZOHO_BOOKS_NETWORK_ENABLED=true
ZOHO_CRM_NETWORK_ENABLED=true
# Enable both only after operational company/accounting verification succeeds.
ZOHO_BOOKS_WRITE_ENABLED=false
ZOHO_BOOKS_LIVE_ENABLED=false
# Legacy deny switch: keep false, including when the two flags above become true.
ALLOW_PRODUCTION_ACCOUNTING_WRITES=false
INTEGRATION_TOKEN_ENCRYPTION_KEY=
ZOHO_BOOKS_DC=
ZOHO_BOOKS_ENVIRONMENT=production
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
ZOHO_BOOKS_ORGANIZATIONS_JSON=
ZOHO_BOOKS_REFRESH_TOKEN=
ZOHO_BOOKS_REFRESH_TOKENS_JSON=
OCR_PROVIDER=disabled
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
SCANNER_IMPORT_ENABLED=false
HUB_BRIDGE_ENABLED=false

# Incoming reads need a separate verified CRM organization/grant as well as Books.
ZOHO_CRM_DC=
ZOHO_CRM_ORGANIZATION_ID=
ZOHO_CRM_ENVIRONMENT=production
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_MAPPING_JSON=
INCOMING_SYNC_ENABLED=true
INCOMING_SYNC_INTERVAL_SECONDS=5
INCOMING_SYNC_RECONCILE_SECONDS=86400
INCOMING_SYNC_MAX_REQUESTS=40
INCOMING_SYNC_ATTACHMENTS_ENABLED=true
INCOMING_SYNC_OPERATOR_EMAIL=
INCOMING_SYNC_OPERATOR_PASSWORD=
INCOMING_SYNC_ATTACHMENT_STATE_FILE=
INCOMING_SYNC_NOT_BEFORE_JSON=
