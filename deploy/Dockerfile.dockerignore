!package-lock.json
!prisma.config.ts
!tsconfig.json
!next.config.ts
!postcss.config.mjs
!prisma/
!prisma/mysql/
!prisma/mysql/**
!src/
!src/**
!scripts/
!scripts/check-release.mjs
!scripts/integration-worker.ts
!scripts/incoming-sync-worker.ts
!scripts/job-history-worker.ts
