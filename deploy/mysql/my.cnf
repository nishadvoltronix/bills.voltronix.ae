[mysqld]
# This must be present before the data directory is first initialized.
lower_case_table_names=1
default_time_zone=+00:00
character_set_server=utf8mb4
collation_server=utf8mb4_0900_ai_ci
require_secure_transport=ON
tls_version=TLSv1.2,TLSv1.3
ssl_ca=/run/bills-mysql/ca-cert.pem
ssl_cert=/run/bills-mysql/server-cert.pem
ssl_key=/run/bills-mysql/server-key.pem
mysqlx=OFF
local_infile=OFF
skip_name_resolve=ON
