{
  "name": "voltronix-bills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "check:release": "node scripts/check-release.mjs",
    "deploy:prepare": "node deploy/prepare.mjs",
    "check:deploy": "node deploy/prepare.mjs --check",
    "check:deploy:posting": "node deploy/prepare.mjs --check-posting",
    "data:export": "node --conditions=react-server --env-file=.env --import=tsx scripts/zoho-data-transfer.ts export",
    "data:check": "node --conditions=react-server --env-file=.env --import=tsx scripts/zoho-data-transfer.ts check",
    "check:manual": "node --conditions=react-server --import=tsx scripts/check-manual-readiness.ts",
    "check:integrations": "node --conditions=react-server --import=tsx scripts/check-integration-readiness.ts",
    "check:sync": "node --conditions=react-server --import=tsx scripts/check-sync-readiness.ts",
    "company:prepare": "node --conditions=react-server --env-file=.env --import=tsx scripts/company-prepare.ts",
    "company:prepare-manual": "node --conditions=react-server --env-file=.env --import=tsx scripts/company-prepare-manual.ts",
    "books:authorize": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-authorize.ts",
    "books:catalog": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-catalog.ts",
    "crm:import-jobs": "node --conditions=react-server --env-file=.env --import=tsx scripts/crm-import-jobs.ts",
    "crm:prepare": "node --conditions=react-server --env-file=.env --import=tsx scripts/crm-prepare.ts",
    "books:download-attachments": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-download-attachments.ts",
    "books:suppliers": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-suppliers.ts",
    "books:local-test": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-local-test.ts",
    "books:verify-live": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-verify-live.ts",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs README.md *.ts *.mjs *.json",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "node scripts/test-integration.mjs",
    "test:ocr:live": "node --conditions=react-server --import=tsx scripts/test-ocr-live.mjs",
    "test:ocr:restart": "node scripts/test-integration.mjs --ocr-restart-only",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "playwright test --config=playwright.isolated.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/mysql-migrate.mjs",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "local:setup": "node scripts/mysql-local.mjs setup",
    "db:local": "node scripts/mysql-local.mjs start",
    "user:create": "tsx --env-file=.env scripts/create-user.ts",
    "user:manage": "node --conditions=react-server --env-file=.env --import=tsx scripts/manage-user.ts",
    "worker:ocr": "node --conditions=react-server --env-file=.env --import=tsx scripts/ocr-worker.ts",
    "worker:scanner": "node --env-file=.env.scanner --import=tsx scripts/scanner-worker.ts",
    "scanner:source": "node --conditions=react-server --env-file=.env --import=tsx scripts/scanner-source.ts",
    "books:connect-local": "node --conditions=react-server --env-file=.env --import=tsx scripts/books-connect-local.ts",
    "test:scanner": "node scripts/test-integration.mjs --scanner-only",
    "backup:verify": "node --conditions=react-server --env-file=.env --import=tsx scripts/verify-restore.ts",
    "worker:sync": "node --conditions=react-server --env-file=.env --import=tsx scripts/integration-worker.ts",
    "worker:incoming": "node --conditions=react-server --env-file=.env --import=tsx scripts/incoming-sync-worker.ts",
    "worker:job-history": "node --conditions=react-server --env-file=.env --import=tsx scripts/job-history-worker.ts",
    "mysql:setup": "node scripts/mysql-local.mjs setup",
    "mysql:start": "node scripts/mysql-local.mjs start",
    "mysql:status": "node scripts/mysql-local.mjs status",
    "mysql:migrate": "node scripts/mysql-migrate.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "lucide-react": "1.62.0",
    "mysql2": "3.24.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
